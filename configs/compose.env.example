# Optional Docker Compose settings. Copy this file to .env in the repository
# root and change only the values you need.

FILETWIST_IMAGE=filetwist:local
FILETWIST_VERSION=dev
# Set to the full source commit when building a release candidate.
FILETWIST_REVISION=unknown
FILETWIST_PORT=127.0.0.1:8080
# The in-container bind port. It drives LISTEN_ADDRESS, the published port, and
# the healthcheck URL together.
FILETWIST_CONTAINER_PORT=8080

FILETWIST_JOB_TTL=24h
FILETWIST_MAX_CONCURRENT_PROCESSES=2
FILETWIST_MAX_FILES_PER_JOB=25
FILETWIST_MAX_UPLOAD_SIZE=4GiB
FILETWIST_MIN_FREE_SPACE=2GiB
FILETWIST_COMMAND_TIMEOUT=10m
FILETWIST_DIAGNOSTICS=local

# Idle windows for one request body and one started response. Both restart on
# read/write operation rather than limiting the total transfer duration.
# Uploads must also meet the rate floor below. Use "off" to disable a window.
FILETWIST_READ_STALL_TIMEOUT=60s
FILETWIST_WRITE_STALL_TIMEOUT=60s
# Average bytes per second a request body must sustain once it outlives the
# read window. "off" disables the floor.
FILETWIST_MIN_UPLOAD_RATE=4KiB

# Peers whose X-Forwarded-For header is believed, as addresses or CIDRs.
# "none" is the default and trusts no forwarded header at all. Set this to
# "loopback" when a reverse proxy runs on the same host. With
# DIAGNOSTICS=local, proxied external clients remain denied.
FILETWIST_TRUSTED_PROXIES=none

# Linux VA-API only. Prefer setting these at invocation time after inspecting
# the render device instead of committing host-specific values.
# VAAPI_DEVICE=/dev/dri/renderD128
# FILETWIST_RENDER_GID=REPLACE_WITH_STAT_OUTPUT
